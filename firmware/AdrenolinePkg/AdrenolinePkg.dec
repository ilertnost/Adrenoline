[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = AdrenolinePkg
  PACKAGE_GUID                   = 6F0B1C1E-6A0E-4C55-9D4B-1B0A4E0A7C11
  PACKAGE_VERSION                = 0.1

[Guids]
  ## Include/Guid/...
  gAdrenolineTokenSpaceGuid  = { 0xC0A1F5D4, 0x7E3B, 0x4C21, { 0x8F, 0x62, 0x1A, 0x55, 0x9D, 0x3E, 0x70, 0x11 } }

[Protocols]

[PcdsFixedAtBuild]
  ## Address of the cell the platform stores the incoming device tree pointer in.
  #  edk2-msm8998 stores x0 there in ArmPlatformPeiBootAction (see the
  #  "oh my fdt" comment in ArmPlatformHelper.S). Used only as a fallback when
  #  the FDT configuration table is not published yet.
  gAdrenolineTokenSpaceGuid.PcdFdtStoreAddress|0x83300000|UINT64|0x83300000

[PcdsDynamic]

[PcdsFeatureFlag]
